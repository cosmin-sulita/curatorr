{
  "name": "@curatorr/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "dev:demo": "tsx watch --clear-screen=false src/index.ts --demo",
    "build": "node build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "tags": "tsx src/scripts/tags.ts",
    "eval": "tsx src/scripts/eval.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@curatorr/shared": "*",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
